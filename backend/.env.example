# Copy this file to backend/.env and fill in your values.

# Required: the Google Cloud project registered with Earth Engine.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Required for the chat, Janus and plain-language explanations.
# The analysis wizard, featured stories and every map tool work without it.
OPENROUTER_API_KEY=sk-or-your-key-here

# Production only: a service account key as one line of JSON.
# EE_CREDENTIALS={"type":"service_account",...}

# Production only: your deployed frontend origin(s), comma separated.
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional: Redis for background simulation jobs. Without it, jobs run inline.
# REDIS_URL=redis://localhost:6379

# Optional: free-tier limits per visitor IP, and a daily ceiling on AI calls.
# RATE_AI_PER_HOUR=60
# RATE_COMPUTE_PER_HOUR=120
# DAILY_AI_CEILING=4000

# Optional: protects POST /feed/sweep. Leave unset to disable manual sweeps.
# SWEEP_TOKEN=choose-a-long-random-string

# Optional: an email for the OpenAlex polite pool (faster Janus literature search).
# OPENALEX_MAILTO=you@example.com

# Optional: Janus proactive monitoring.
# JANUS_WATCH_ENABLED=1
# JANUS_WATCH_INTERVAL_HOURS=12
